{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "inlineSourceMap": true,
    "outDir": "./.medusa/server",
    "rootDir": "./",
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "checkJs": false,
    "strictNullChecks": true
  },
  "ts-node": {
    "swc": true
  },
  "include": [
    "**/*",
    ".medusa/types/*"
  ],
  "exclude": [
    "node_modules",
    ".medusa/server",
    ".medusa/admin",
    ".cache",
    // Medusa's policy codegen (@medusajs/utils policy-to-types, still in
    // 2.21.2) writes resource keys unquoted, so the `*` resource of
    // src/policies/desk-bots.ts comes out as `readonly *: "*"`, which does
    // not parse. Nothing here uses these generated types. Both files go:
    // policy-bindings pulls policy-types in through a /// reference.
    ".medusa/types/policy-types.d.ts",
    ".medusa/types/policy-bindings.d.ts"
  ]
}

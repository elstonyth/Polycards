{
  "name": "@acme/api",
  "version": "2.1.6",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "exports": {
    "./_generated": {
      "types": "./.mercur/_generated/index.ts"
    }
  },
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "check-types": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "seed:e2e": "medusa exec ./src/scripts/seed-e2e-fixtures.ts",
    "deploy:init": "medusa db:migrate --execute-safe-links && medusa exec ./src/scripts/seed.ts && medusa exec ./src/scripts/print-publishable-key.ts",
    "deploy:migrate-user": "node ./src/scripts/repair-product-option-pivots.cjs && medusa db:migrate --execute-safe-links && medusa exec ./src/scripts/create-admin.ts && medusa exec ./src/scripts/seed-vip-achievements.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "test:integration:http": "node integration-tests/run-http-shards.mjs",
    "test:integration:smoke": "node integration-tests/run-http-shards.mjs economy.spec credit-topup.spec pack-open-charge.spec vault-buyback.spec ledger-conservation.spec",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "telegram:probe": "TELEGRAM_PROBE=1 TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --runInBand --forceExit telegram-live"
  },
  "dependencies": {
    "@acme/odds-math": "workspace:*",
    "@acme/pokemon": "workspace:*",
    "@medusajs/admin-sdk": "2.19.0",
    "@medusajs/admin-shared": "2.19.0",
    "@medusajs/auth-google": "2.19.0",
    "@medusajs/cli": "2.19.0",
    "@medusajs/dashboard": "2.19.0",
    "@medusajs/draft-order": "2.19.0",
    "@medusajs/framework": "2.19.0",
    "@medusajs/medusa": "2.19.0",
    "@mercurjs/cli": "2.3.1",
    "@mercurjs/core": "2.3.1",
    "@mercurjs/types": "2.3.1",
    "http-proxy-middleware": "^3.0.7",
    "ioredis": "^5.4.1",
    "multer": "^2.3.0",
    "resend": "^6.25.0",
    "sharp": "^0.35.4",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.19.0",
    "@swc/core": "^1.16.0",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "fflate": "^0.8.2",
    "jest": "^30.5.0",
    "prop-types": "^15.8.1",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  }
}

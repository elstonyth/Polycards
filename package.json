{
  "name": "polycards-game",
  "version": "1.0.0-rc",
  "private": true,
  "description": "Polycards — a web-based game built with Next.js, React, and Tailwind CSS.",
  "author": "elstonyth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/elstonyth/Polycards.git"
  },
  "homepage": "https://github.com/elstonyth/Polycards#readme",
  "bugs": {
    "url": "https://github.com/elstonyth/Polycards/issues"
  },
  "keywords": [
    "game",
    "polycards",
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts",
    "test": "vitest run",
    "qa:csp": "node scripts/qa-csp.mjs",
    "test:a11y": "node scripts/qa-a11y.mjs",
    "qa:free-pack": "node scripts/qa-free-pack.mjs",
    "qa:catalog-groups": "node scripts/qa-catalog-groups.mjs",
    "qa:motion13": "node scripts/qa-motion13.mjs",
    "qa:reset-countdown": "node scripts/qa-reset-countdown.mjs",
    "qa:prod-smoke": "node scripts/qa-prod-smoke.mjs",
    "qa:postwipe-spin": "node scripts/qa-postwipe-spin.mjs"
  },
  "dependencies": {
    "@medusajs/js-sdk": "^2.19.0",
    "@medusajs/types": "^2.19.0",
    "@sentry/nextjs": "^10.70.0",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.11",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.1",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-easy-crop": "^6.2.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jsdom": "^30.0.1",
    "playwright": "^1.60.0",
    "prettier": "^3.9.6",
    "shadcn": "^4.19.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "$sharp"
  }
}
